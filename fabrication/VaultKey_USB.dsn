      (pins D1-2 R5-2)
    )
    (class kicad_default BOOT EN LED_A OLED_RST OLED_SCL OLED_SDA RTC_SCL
      RTC_SDA RTC_X1 RTC_X2 SW_BACK SW_DOWN SW_SELECT SW_UP USB_DM USB_DP
      VBAT
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 250)
        (clearance 200)
      )
    )
    (class Power +3V3 +5V GND USB_VBUS
      (circuit
        (use_via "Via[0-1]_800:400_um")
      )
      (rule
        (width 500)
        (clearance 250)
      )
    )
  )
  (wiring
    (wire (path F.Cu 500  4500 -21500  13000 -22000)(net GND)(type route))
    (via "Via[0-1]_800:400_um"  13000 -22000 (net GND)(type route))
  )
)
